# Copy to .env (git-ignored). Bun loads it for `bun run dev`, `build` and
# `package`; the values are built into the main process.

# "Sign in with Google" for private Google Sheets: an OAuth client of type
# "Desktop app" (from its client_secret_….json). Left empty, the app asks
# for that JSON file instead.
VEYLENS_GOOGLE_CLIENT_ID=
VEYLENS_GOOGLE_CLIENT_SECRET=
