{
  "name": "veylens",
  "productName": "Vey Lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "//build": "Vite through its JS entry rather than its bin shim, so it runs under bun whatever `node` is on PATH (it needs Node 20.19+).",
    "build": "bun scripts/build-electron.mjs --minify && bun node_modules/vite/bin/vite.js build",
    "package": "bun run build && electron-builder",
    "typecheck": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json",
    "test": "bun test/db.ts && bun test/features.ts",
    "demo:pg": "bun scripts/demo-db.ts"
  },
  "//dependencies": "Only what the packaged app loads from node_modules at runtime: the database drivers stay esbuild externals (dynamic requires). Everything else is bundled by esbuild (main) or Vite (renderer) and lives below.",
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.13.0",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0",
    "pg-cursor": "^2.12.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.241",
    "@base-ui/react": "^1.6.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@lezer/highlight": "^1.2.5",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/pg-cursor": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "lucide-react": "^1.27.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^7.1.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "trustedDependencies": [
    "electron"
  ],
  "build": {
    "appId": "vn.app.veylens",
    "productName": "Vey Lens",
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Vey-Lens-${version}-${arch}.${ext}",
      "hardenedRuntime": true
    },
    "win": {
      "target": "nsis",
      "artifactName": "Vey-Lens-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "artifactName": "Vey-Lens-${version}-${arch}.${ext}"
    }
  }
}
